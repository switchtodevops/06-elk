# Elastic Stack version
STACK_VERSION=8.19.19

# Cluster name
CLUSTER_NAME=elastic-wsl-cluster

# Login password for the elastic superuser
ELASTIC_PASSWORD=admin1234

# Internal password used by Kibana
KIBANA_PASSWORD=admin1234

# Basic license
LICENSE=basic

# Elasticsearch and Kibana ports
ES_PORT=9200
KIBANA_PORT=5601

# Memory limit per Elasticsearch container: 2 GB
MEM_LIMIT=2147483648

# Elasticsearch JVM heap
ES_JAVA_OPTS=-Xms1g -Xmx1g
